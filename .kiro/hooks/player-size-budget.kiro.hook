{
  "enabled": true,
  "name": "Player size budget (30 KB min+gzip)",
  "description": "Rebuilds the player when it or the core it imports changes, and fails if it exceeds the budget.",
  "version": "1",
  "when": { "type": "fileEdited", "patterns": ["src/player/**/*.ts", "src/core/**/*.ts"] },
  "then": { "type": "runCommand", "command": "npm run size" }
}
